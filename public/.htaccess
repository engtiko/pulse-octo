# Custom HTTP 404 Page (Missing pages return real 404, never HTTP 200)
ErrorDocument 404 /404.html

# Proper MIME Types for Agent Discovery & Markdown Content Negotiation
AddType text/markdown .md
AddType text/plain .txt
AddType application/json .json

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve Markdown representation when AI agents request Accept: text/markdown on homepage
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^/?$ /index.md [L,T=text/markdown;charset=utf-8]

  # 2. Serve existing real files and directories directly (including .well-known, llms.txt, index.md, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Rewrite ONLY known SPA routes to /index.html (unknown routes fall through to real HTTP 404)
  RewriteRule ^(home|who-we-are|about|the-8-arms|eight-arms|arms|services|our-services|portfolio|projects|blog|insights|contact|privacy|terms|card|vcard|tarek|ceo|id|business-card|branding|digital-marketing|marketing|web-ecommerce|creative-studio|studio|digital-products|brand-strategy|strategy|content-creation|content|seo-growth|growth|arm-[1-8]|service-[1-8]|studio-admin)/?$ /index.html [L,NC]
</IfModule>

# Enable Brotli & Gzip / Deflate Compression for Faster Transfer & SEO Core Web Vitals
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/markdown text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json application/ld+json application/manifest+json image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json application/ld+json application/manifest+json image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# Browser Caching for Static Assets (1 Year Immutable for JS, CSS, Images, Fonts, Media)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/markdown "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/ld+json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|otf|eot|png|jpg|jpeg|webp|avif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Emit RFC 8288 Link header & Vary: Accept on homepage HTML
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header append Vary "Accept"
    Header always set Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
  </FilesMatch>

  <FilesMatch "^index\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
    Header append Vary "Accept"
    Header always set Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </>; rel=\"alternate\"; type=\"text/html\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\""
  </FilesMatch>

  <FilesMatch "^llms\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "^server-card\.json$">
    Header set Content-Type "application/json; charset=utf-8"
    Header set Cache-Control "public, max-age=3600"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header set Connection keep-alive
</IfModule>
