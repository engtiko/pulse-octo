{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "security-check": "npm audit --audit-level=critical",
    "lighthouse": "tsx scripts/lighthouse-monitor.ts",
    "lighthouse:watch": "tsx scripts/lighthouse-monitor.ts --watch --interval=30",
    "lighthouse:ci": "npx --yes @lhci/cli@0.14.x autorun || tsx scripts/lighthouse-monitor.ts",
    "perf:audit": "vite build && tsx scripts/lighthouse-monitor.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "body-parser": "^1.20.9",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^1.77.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "three": "^0.186.1",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "esbuild": "^0.28.2",
    "qs": "^6.17.1",
    "source-map-js": "^1.2.2",
    "vite": "^6.4.5"
  },
  "snyk": true,
  "securityPolicy": {
    "configFile": "./snyk.json",
    "severityThreshold": "high",
    "failOn": "upgradable",
    "contact": "sales@pulseocto.com"
  }
}
